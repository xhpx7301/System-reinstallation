        local sel=""
        if ! read_input "请选择" "0" sel; then
            return 0
        fi
        case "$sel" in
            0) return 0 ;;
            1)
                update_upstream_script 1
                pause_key
                ;;
            2)
                local cid=""
                read_input "输入 commit_id (输入 main 恢复最新版)" "$CFG_UPSTREAM_COMMIT" cid
                if [ -n "$cid" ]; then
                    CFG_UPSTREAM_COMMIT="$cid"
                    save_config
                    update_upstream_script 1
                fi
                pause_key
                ;;
            3)
                ensure_upstream_script && bash "$REINSTALL_SCRIPT" --help || true
                pause_key
                ;;
            4)
                self_update_sr
                pause_key
                ;;
            5)
                uninstall_sr
                ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Main Menu & CLI Entrypoint
# ---------------------------------------------------------------------------

show_cli_help() {
    cat <<EOF
SR v${SR_VERSION} - bin456789/reinstall 交互式管理菜单

用法:
  sr / SR                  启动交互式管理菜单
  sr update                立即更新缓存的 reinstall.sh
  sr reset                 取消尚未重启的重装任务
  sr config                打开预设配置管理
  sr uninstall             卸载 SR 及其缓存与配置
  sr -- <reinstall 参数>   直接透传参数给底层 reinstall.sh
  sr help                  显示本帮助信息

上游项目: $UPSTREAM_REPO
EOF
}

main_menu() {
    while true; do
        clear_screen
        local root_badge="${C_GREEN}root${C_RESET}"
        if [ "$(id -u)" -ne 0 ]; then
            root_badge="${C_YELLOW}非root (仅可预览命令)${C_RESET}"
        fi
        local cached_badge="${C_YELLOW}未缓存${C_RESET}"
        if [ -s "$REINSTALL_SCRIPT" ]; then
            cached_badge="${C_GREEN}就绪${C_RESET}"
        fi

        printf '%s====================================================%s\n' "$C_CYAN" "$C_RESET"
        printf '%s  SR 系统重装管理菜单 v%s%s\n' "$C_BOLD" "$SR_VERSION" "$C_RESET"
        printf '  基于: %s\n' "$UPSTREAM_REPO"
        printf '  权限: %b | 上游脚本: %b | 源: %s\n' "$root_badge" "$cached_badge" "$CFG_MIRROR"
        printf '%s====================================================%s\n' "$C_CYAN" "$C_RESET"
        printf '  1. 重装 Linux 系统    (Debian/Ubuntu/Alpine/RHEL系等)\n'
        printf '  2. 重装 Windows 系统  (官方原版 ISO / 自定义 ISO)\n'
        printf '  3. 自定义 DD 镜像     (--img raw/vhd/gz/xz/zst)\n'
        printf '  4. 救援与网络引导     (Alpine Live OS / netboot.xyz / Talos)\n'
        printf '  5. 取消已安排的重装   (reset)\n'
        printf '%s----------------------------------------------------%s\n' "$C_DIM" "$C_RESET"
        printf '  6. 预设配置管理       (默认 SSH 公钥 / 端口 / 下载源)\n'
        printf '  7. 脚本与环境维护     (更新上游脚本 / 版本锁定 / 卸载)\n'
        printf '  0. 退出\n'
        printf '%s====================================================%s\n' "$C_CYAN" "$C_RESET"

        local choice=""
        if ! read_input "请输入选项 [0-7]" "" choice; then
            printf '\n已退出 SR。\n'
            exit 0
        fi
        case "$choice" in
            1) menu_linux ;;
            2) menu_windows ;;
            3) menu_dd ;;
            4) menu_rescue ;;
            5) action_reset ;;
            6) menu_config ;;
            7) menu_maintenance ;;
            0|q|Q|exit)
                printf '已退出 SR。\n'
                exit 0
                ;;
            *)
                msg_warn "无效选项: $choice"
                sleep 1
                ;;
        esac
    done
}

load_config

case "${1:-}" in
    "")
        main_menu
        ;;
    -h|--help|help)
        show_cli_help
        ;;
    -v|--version|version)
        printf 'SR v%s\n' "$SR_VERSION"
        ;;
    update)
        update_upstream_script 1
        ;;
    reset)
        action_reset
        ;;
    config)
        menu_config
        ;;
    uninstall)
        uninstall_sr
        ;;
    --)
        shift
        ensure_upstream_script || exit 1
        exec bash "$REINSTALL_SCRIPT" "$@"
        ;;
    *)
        # Convenience passthrough if user runs e.g. `sr debian 12 ...`
        ensure_upstream_script || exit 1
        exec bash "$REINSTALL_SCRIPT" "$@"
        ;;
esac
