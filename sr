# ---------------------------------------------------------------------------
# Feature 7: Script Maintenance & Self-Update / Uninstall
# ---------------------------------------------------------------------------

self_update_sr() {
    local update_url="${SR_SELF_RAW_URL:-$CFG_SELF_URL}"
    if [ -z "$update_url" ]; then
        msg_warn "未配置 sr 脚本下载地址（如 https://raw.githubusercontent.com/<user>/<repo>/main/sr）。"
        read_input "请输入 sr 脚本的 Raw 下载地址 (留空取消)" "" update_url
        [ -n "$update_url" ] || return 0
    fi
    local tmp_sr="${SR_BIN_PATH}.tmp.$$"
    msg_info "正在拉取最新 sr 脚本..."
    if download_file "$update_url" "$tmp_sr" && [ -s "$tmp_sr" ]; then
        if grep -q "SR_VERSION=" "$tmp_sr" 2>/dev/null; then
            CFG_SELF_URL="$update_url"
            save_config
            chmod 755 "$tmp_sr"
            mv -f "$tmp_sr" "$SR_BIN_PATH"
            msg_info "sr 更新完成，重新启动中..."
            exec "$SR_BIN_PATH"
        else
            rm -f "$tmp_sr"
            msg_err "下载的内容不是有效的 sr 脚本。"
        fi
    else
        rm -f "$tmp_sr"
        msg_err "下载失败。"
    fi
}

uninstall_sr() {
    printf '\n%s将要删除以下文件:%s\n' "$C_YELLOW" "$C_RESET"
    printf '  - %s\n' "$SR_BIN_PATH"
    printf '  - %s\n' "$SR_ALIAS_PATH"
    printf '  - %s (缓存目录)\n' "$SR_DATA_DIR"
    printf '  - %s (配置目录)\n' "$SR_CONF_DIR"

    if ! confirm_yn "确定完全卸载 SR 管理菜单吗？" "N"; then
        return 0
    fi

    rm -rf "$SR_DATA_DIR" "$SR_CONF_DIR"
    if [ -L "$SR_ALIAS_PATH" ] || [ -f "$SR_ALIAS_PATH" ]; then
        rm -f "$SR_ALIAS_PATH"
    fi
    rm -f "$SR_BIN_PATH"
    msg_info "SR 已卸载完成。"
    exit 0
}

