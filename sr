#!/usr/bin/env sh
# shellcheck shell=bash
# SR - Interactive management menu for https://github.com/bin456789/reinstall

# Bootstrap into bash on minimal systems (e.g., Alpine Linux)
if [ -z "${BASH:-}" ] || { [ -n "${BASH:-}" ] && [ -n "${POSIXLY_CORRECT:-}" ]; }; then
    if ! command -v bash >/dev/null 2>&1; then
        if [ -f /etc/alpine-release ] && [ "$(id -u)" -eq 0 ]; then
            echo "[SR] Installing bash on Alpine Linux..." >&2
            apk add --no-cache bash >/dev/null || {
                echo "[SR] Failed to install bash." >&2
                exit 1
            }
        else
            echo "[SR] bash is required. Please install bash and retry." >&2
            exit 1
        fi
    fi
    exec bash "$0" "$@"
fi

set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

SR_VERSION="1.0.0"
UPSTREAM_REPO="https://github.com/bin456789/reinstall"
UPSTREAM_RAW_GH="https://raw.githubusercontent.com/bin456789/reinstall"
UPSTREAM_RAW_CN="https://cnb.cool/bin456789/reinstall/-/git/raw"

# Optional: configure your own repository raw base URL for `sr self-update`
SR_SELF_RAW_URL="${SR_SELF_RAW_URL:-}"

# Storage paths (root vs non-root)
if [ "$(id -u)" -eq 0 ]; then
    SR_DATA_DIR="${SR_DATA_DIR:-/usr/local/share/sr}"
    SR_CONF_DIR="${SR_CONF_DIR:-/etc/sr}"
    SR_BIN_PATH="${SR_BIN_PATH:-/usr/local/bin/sr}"
    SR_ALIAS_PATH="${SR_ALIAS_PATH:-/usr/local/bin/SR}"
else
    SR_DATA_DIR="${SR_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/sr}"
    SR_CONF_DIR="${SR_CONF_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/sr}"
    SR_BIN_PATH="${SR_BIN_PATH:-$HOME/.local/bin/sr}"
    SR_ALIAS_PATH="${SR_ALIAS_PATH:-$HOME/.local/bin/SR}"
fi

SR_CONF_FILE="$SR_CONF_DIR/config"
REINSTALL_SCRIPT="$SR_DATA_DIR/reinstall.sh"

# Default persistent settings
CFG_MIRROR="auto"          # auto | github | cn
CFG_SSH_KEY=""             # e.g. github:username, /root/.ssh/id_ed25519.pub, or raw key
CFG_SSH_PORT=""            # e.g. 2222
CFG_WEB_PORT=""            # e.g. 8080
CFG_USERNAME=""            # default empty -> upstream default (root / administrator)
CFG_NO_CLOUD_KERNEL="0"    # 0 | 1
CFG_MINIMAL="0"            # 0 | 1
CFG_FORCE_CN="0"           # 0 | 1
CFG_UPSTREAM_COMMIT="main" # main or commit hash
CFG_SELF_URL="${SR_SELF_RAW_URL:-}"

# Colors (disabled when stdout is not a terminal or NO_COLOR is set)
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_BLUE=$'\033[34m'
    C_CYAN=$'\033[36m'
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
fi

# ---------------------------------------------------------------------------
# UI & Utility Helpers
# ---------------------------------------------------------------------------

msg_info()  { printf '%s[INFO]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
msg_warn()  { printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
msg_err()   { printf '%s[ERR ]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }

clear_screen() {
    if [ -t 1 ]; then
        printf '\033[2J\033[H'
    fi
}

pause_key() {
    printf '\n%s按回车键继续...%s' "$C_DIM" "$C_RESET"
    IFS= read -r _ || true
}

read_input() {
    local prompt="$1"
    local default_val="${2:-}"
    local var_name="$3"
    local input=""

    if [ -n "$default_val" ]; then
        printf '%s [%s]: ' "$prompt" "$default_val" >&2
    else
        printf '%s: ' "$prompt" >&2
    fi
    if ! IFS= read -r input; then
        printf -v "$var_name" '%s' "$default_val"
        return 1
    fi
    input="${input%$'\r'}"
    if [ -z "$input" ]; then
        input="$default_val"
    fi
    printf -v "$var_name" '%s' "$input"
}

read_secret() {
    local prompt="$1"
    local var_name="$2"
    local input=""

    printf '%s: ' "$prompt" >&2
    if ! IFS= read -rs input; then
        printf '\n' >&2
        printf -v "$var_name" '%s' ""
        return 1
    fi
    input="${input%$'\r'}"
    printf '\n' >&2
    printf -v "$var_name" '%s' "$input"
}

confirm_yn() {
    local prompt="$1"
    local default_ans="${2:-N}"
    local ans=""
    local hint="[y/N]"
    if [ "$default_ans" = "Y" ]; then
        hint="[Y/n]"
    fi
    printf '%s %s: ' "$prompt" "$hint" >&2
    IFS= read -r ans || return 1
    ans="${ans%$'\r'}"
    ans="${ans:-$default_ans}"
    case "$ans" in
        [yY]|[yY][eE][sS]) return 0 ;;
        *) return 1 ;;
    esac
}

is_valid_port() {
    local p="$1"
    case "$p" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$p" -ge 1 ] && [ "$p" -le 65535 ]
}

# Print shell-escaped command; if mask_pw=1, hide password argument
format_cmd() {
    local mask_pw="${1:-1}"
    shift
    local out=""
    local skip_next=0
    local arg=""
    for arg in "$@"; do
        if [ "$skip_next" -eq 1 ]; then
            out+=" '***'"
            skip_next=0
            continue
        fi
        if [ "$mask_pw" -eq 1 ] && { [ "$arg" = "--password" ] || [ "$arg" = "--passwd" ]; }; then
            out+=" $arg"
            skip_next=1
            continue
        fi
        out+=" $(printf '%q' "$arg")"
    done
    printf '%s\n' "${out# }"
}

detect_cn_network() {
    # Quick heuristic: check timezone or fast probe to github/cnb
    local tz=""
    if [ -f /etc/timezone ]; then
        tz=$(cat /etc/timezone 2>/dev/null || true)
    elif [ -L /etc/localtime ]; then
        tz=$(readlink -f /etc/localtime 2>/dev/null || true)
    fi
    case "$tz" in
        *Shanghai*|*Chongqing*|*Beijing*|*Asia/Urumqi*)
            return 0
            ;;
    esac
    return 1
}

download_file() {
    local url="$1"
    local dest="$2"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --connect-timeout 10 --max-time 60 "$url" -o "$dest"
    elif command -v wget >/dev/null 2>&1; then
        wget -q --timeout=15 -O "$dest" "$url"
    else
        msg_err "未找到 curl 或 wget，无法下载文件。"
        return 1
    fi
}

# ---------------------------------------------------------------------------
# Config Management
# ---------------------------------------------------------------------------

load_config() {
    if [ -f "$SR_CONF_FILE" ]; then
        # Safely parse known KEY=VALUE pairs without executing arbitrary shell code
        local key="" val=""
        while IFS='=' read -r key val; do
            case "$key" in
                ''|\#*) continue ;;
                CFG_MIRROR)          CFG_MIRROR="$val" ;;
                CFG_SSH_KEY)         CFG_SSH_KEY="$val" ;;
                CFG_SSH_PORT)        CFG_SSH_PORT="$val" ;;
                CFG_WEB_PORT)        CFG_WEB_PORT="$val" ;;
                CFG_USERNAME)        CFG_USERNAME="$val" ;;
                CFG_NO_CLOUD_KERNEL) CFG_NO_CLOUD_KERNEL="$val" ;;
                CFG_MINIMAL)         CFG_MINIMAL="$val" ;;
                CFG_FORCE_CN)        CFG_FORCE_CN="$val" ;;
                CFG_UPSTREAM_COMMIT) CFG_UPSTREAM_COMMIT="$val" ;;
                CFG_SELF_URL)        CFG_SELF_URL="$val" ;;
            esac
        done < "$SR_CONF_FILE"
    fi
}

save_config() {
    mkdir -p "$SR_CONF_DIR"
    umask 077
    cat > "$SR_CONF_FILE" <<EOF
# SR Configuration File
CFG_MIRROR=$CFG_MIRROR
CFG_SSH_KEY=$CFG_SSH_KEY
CFG_SSH_PORT=$CFG_SSH_PORT
CFG_WEB_PORT=$CFG_WEB_PORT
CFG_USERNAME=$CFG_USERNAME
CFG_NO_CLOUD_KERNEL=$CFG_NO_CLOUD_KERNEL
CFG_MINIMAL=$CFG_MINIMAL
CFG_FORCE_CN=$CFG_FORCE_CN
CFG_UPSTREAM_COMMIT=$CFG_UPSTREAM_COMMIT
CFG_SELF_URL=$CFG_SELF_URL
EOF
    chmod 600 "$SR_CONF_FILE" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Upstream Script Management
# ---------------------------------------------------------------------------

get_upstream_urls() {
    local ref="${CFG_UPSTREAM_COMMIT:-main}"
    local gh_url="$UPSTREAM_RAW_GH/$ref/reinstall.sh"
    local cn_url="$UPSTREAM_RAW_CN/$ref/reinstall.sh"

    case "$CFG_MIRROR" in
        github)
            printf '%s\n' "$gh_url"
            ;;
        cn)
            printf '%s\n' "$cn_url"
            ;;
        *)
            if detect_cn_network; then
                printf '%s\n%s\n' "$cn_url" "$gh_url"
            else
                printf '%s\n%s\n' "$gh_url" "$cn_url"
            fi
            ;;
    esac
}

update_upstream_script() {
    local force="${1:-1}"
    if [ "$force" -eq 0 ] && [ -s "$REINSTALL_SCRIPT" ]; then
        return 0
    fi

    mkdir -p "$SR_DATA_DIR"
    local tmp_file="$SR_DATA_DIR/reinstall.sh.tmp.$$"
    local url=""
    local ok=0

    while IFS= read -r url; do
        [ -n "$url" ] || continue
        msg_info "正在从 $url 下载 reinstall.sh ..."
        if download_file "$url" "$tmp_file" && [ -s "$tmp_file" ]; then
            # Sanity check: verify file looks like bin456789/reinstall
            if grep -q "SCRIPT_VERSION=" "$tmp_file" 2>/dev/null; then
                ok=1
                break
            else
                msg_warn "下载的文件校验失败，尝试下一个源..."
            fi
        else
            msg_warn "下载失败: $url"
        fi
    done < <(get_upstream_urls)

    if [ "$ok" -eq 1 ]; then
        mv -f "$tmp_file" "$REINSTALL_SCRIPT"
        chmod +x "$REINSTALL_SCRIPT"
        # If pinned to a specific commit, adjust confhome inside script as upstream recommends
        if [ "${CFG_UPSTREAM_COMMIT:-main}" != "main" ]; then
            sed -i "/^confhome.*main$/s/main/${CFG_UPSTREAM_COMMIT}/" "$REINSTALL_SCRIPT" 2>/dev/null || true
        fi
        msg_info "reinstall.sh 已就绪: $REINSTALL_SCRIPT"
        return 0
    else
        rm -f "$tmp_file"
        msg_err "无法下载 reinstall.sh，请检查网络连接或切换下载源。"
        return 1
    fi
}

ensure_upstream_script() {
    if [ ! -s "$REINSTALL_SCRIPT" ]; then
        update_upstream_script 1
    fi
}

# ---------------------------------------------------------------------------
# System Pre-flight Checks
# ---------------------------------------------------------------------------

check_virt_compat() {
    if [ -f /proc/user_beancounters ]; then
        msg_warn "检测到 OpenVZ 环境，bin456789/reinstall 不支持 OpenVZ/LXC！"
        return 1
    fi
    if command -v systemd-detect-virt >/dev/null 2>&1; then
        local virt=""
        virt=$(systemd-detect-virt 2>/dev/null || true)
        case "$virt" in
            openvz|lxc|lxc-libvirt)
                msg_warn "检测到容器虚拟化 ($virt)，bin456789/reinstall 不支持 OpenVZ/LXC！"
                return 1
                ;;
        esac
    fi
    return 0
}

get_mem_mb() {
    awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo "?"
}

get_root_disk_gb() {
    df -BG / 2>/dev/null | awk 'NR==2 {gsub(/G/,"",$2); print $2}' || echo "?"
}

get_arch() {
    uname -m 2>/dev/null || echo "unknown"
}

get_os_pretty() {
    if [ -f /etc/os-release ]; then
        awk -F= '/^PRETTY_NAME=/ {gsub(/"/,"",$2); print $2; exit}' /etc/os-release
    else
        uname -s
    fi
}

# ---------------------------------------------------------------------------
# Execution & Preview Layer
# ---------------------------------------------------------------------------

run_or_preview() {
    local mode_label="$1"
    local destructive="${2:-1}"
    shift 2
    local cmd_args=("$@")

    ensure_upstream_script || {
        pause_key
        return 1
    }

    local full_cmd=("bash" "$REINSTALL_SCRIPT" "${cmd_args[@]}")

    printf '\n%s================ 执行前确认 ================%s\n' "$C_CYAN" "$C_RESET"
    printf '操作模式: %s%s%s\n' "$C_BOLD" "$mode_label" "$C_RESET"
    printf '当前系统: %s (%s) | 内存: %s MB | 根分区: %s GB\n' \
        "$(get_os_pretty)" "$(get_arch)" "$(get_mem_mb)" "$(get_root_disk_gb)"

    if [ "$destructive" -eq 1 ]; then
        printf '%s[警告] 此操作将清空目标硬盘上的全部数据！%s\n' "$C_RED$C_BOLD" "$C_RESET"
        printf '%s提示: 若误运行且尚未重启，可执行 `sr reset` 或 `bash %s reset` 取消。%s\n' \
            "$C_YELLOW" "$REINSTALL_SCRIPT" "$C_RESET"
    else
        printf '%s[提示] 此操作不会自动格式化硬盘数据。%s\n' "$C_GREEN" "$C_RESET"
    fi

    printf '\n即将执行的命令（密码已脱敏）:\n'
    printf '  %s%s%s\n\n' "$C_BOLD" "$(format_cmd 1 "${full_cmd[@]}")" "$C_RESET"

    if [ "$(id -u)" -ne 0 ]; then
        msg_warn "当前非 root 用户，真正执行系统重装需要 root 权限 (sudo)。"
    fi

    check_virt_compat || true

    printf '请选择操作:\n'
    printf '  1. 确认并立即执行\n'
    printf '  2. 仅输出完整命令 (Dry-run / 复制)\n'
    printf '  3. 仅输出脱敏命令 (Dry-run)\n'
    printf '  0. 取消并返回\n'

    local choice=""
    read_input "输入选项" "0" choice
    case "$choice" in
        1)
            if [ "$(id -u)" -ne 0 ]; then
                msg_err "必须使用 root 权限执行！请使用 sudo sr 或切换到 root 后重试。"
                pause_key
                return 1
            fi
            if [ "$destructive" -eq 1 ]; then
                local confirm_word=""
                printf '%s请输入 YES (全大写) 以确认开始清盘重装: %s' "$C_RED$C_BOLD" "$C_RESET"
                IFS= read -r confirm_word
                if [ "$confirm_word" != "YES" ]; then
                    msg_info "已取消执行。"
                    pause_key
                    return 0
                fi
            fi
            printf '\n'
            msg_info "正在启动 reinstall.sh ..."
            "${full_cmd[@]}"
            local rc=$?
            printf '\n'
            if [ "$rc" -eq 0 ]; then
                msg_info "reinstall.sh 执行完成 (退出码: 0)。"
                if [ "$destructive" -eq 1 ]; then
                    msg_warn "如需取消重装，请在重启前运行: sr reset"
                    if confirm_yn "是否立即重启 (reboot) 使重装生效？" "N"; then
                        reboot
                    fi
                else
                    if confirm_yn "是否立即重启 (reboot) 进入目标环境？" "N"; then
                        reboot
                    fi
                fi
            else
                msg_err "reinstall.sh 退出异常 (退出码: $rc)。"
            fi
            pause_key
            ;;
        2)
            printf '\n%s完整命令:%s\n%s\n' "$C_GREEN" "$C_RESET" "$(format_cmd 0 "${full_cmd[@]}")"
            pause_key
            ;;
        3)
            printf '\n%s脱敏命令:%s\n%s\n' "$C_GREEN" "$C_RESET" "$(format_cmd 1 "${full_cmd[@]}")"
            pause_key
            ;;
        *)
            msg_info "已取消。"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Common Option Prompt Builders
# ---------------------------------------------------------------------------

prompt_ssh_key() {
    local current_key="${1:-$CFG_SSH_KEY}"
    local result_var="$2"
    local val=""

    printf '\n%sSSH 公钥设置%s (支持 raw 公钥 / 文件路径 / github:用户名 / gitlab:用户名 / URL)\n' "$C_CYAN" "$C_RESET"
    if [ -n "$current_key" ]; then
        printf '当前默认: %s\n' "$current_key"
    fi
    printf '快捷选择: [回车]沿用默认  [1]使用本机公钥  [2]github:用户名  [3]手动输入  [4]清空不使用\n'
    local sel=""
    read_input "选择方式" "" sel
    case "$sel" in
        "")
            val="$current_key"
            ;;
        1)
            local found=""
            local f=""
            for f in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_rsa.pub" "$HOME/.ssh/id_ecdsa.pub" "$HOME/.ssh/authorized_keys"; do
                if [ -s "$f" ]; then
                    found="$f"
                    break
                fi
            done
            if [ -n "$found" ]; then
                msg_info "检测到本机公钥文件: $found"
                val="$found"
            else
                msg_warn "未在 $HOME/.ssh/ 找到常用公钥文件，请手动输入。"
                read_input "请输入公钥或路径" "" val
            fi
            ;;
        2)
            local gh_user=""
            read_input "输入 GitHub 用户名" "" gh_user
            if [ -n "$gh_user" ]; then
                val="github:$gh_user"
            fi
            ;;
        3)
            read_input "输入 SSH 公钥 / 路径 / URL" "" val
            ;;
        4)
            val=""
            ;;
        *)
            # Treat direct pasted key/path as input
            val="$sel"
            ;;
    esac
    printf -v "$result_var" '%s' "$val"
}

prompt_common_auth_ports() {
    local mode="$1" # linux | windows | dd | alpine
    local default_user_hint="root"
    if [ "$mode" = "windows" ]; then
        default_user_hint="administrator"
    fi

    OPT_USER="$CFG_USERNAME"
    OPT_PASS=""
    OPT_SSH_KEY=""
    OPT_SSH_PORT="$CFG_SSH_PORT"
    OPT_WEB_PORT="$CFG_WEB_PORT"
    OPT_RDP_PORT=""
    OPT_FRPC=""
    OPT_HOLD=""
    OPT_TARGET_DISK=""
    OPT_FORCE_CN="$CFG_FORCE_CN"
    OPT_DEBUG="0"
    OPT_EXTRA=""

    printf '\n%s--- 账号与连接设置 (直接回车保留默认/留空由上游自动处理) ---%s\n' "$C_CYAN" "$C_RESET"
    read_input "用户名 (留空默认 $default_user_hint)" "$OPT_USER" OPT_USER

    if [ "$mode" != "windows" ]; then
        prompt_ssh_key "$CFG_SSH_KEY" OPT_SSH_KEY
    fi

    if [ -n "$OPT_SSH_KEY" ] && [ "$mode" = "linux" ]; then
        msg_info "已配置 SSH 公钥（上游在启用公钥时密码默认为空，如需同时设密码可输入，否则直接回车跳过）。"
    fi
    read_secret "登录密码 (输入时不可见；留空则按上游默认/随机生成)" OPT_PASS

    while true; do
        read_input "SSH 端口 (留空默认 22)" "$OPT_SSH_PORT" OPT_SSH_PORT
        if [ -z "$OPT_SSH_PORT" ] || is_valid_port "$OPT_SSH_PORT"; then
            break
        fi
        msg_warn "端口号无效，请输入 1-65535 之间的数字。"
        OPT_SSH_PORT=""
    done

    if [ "$mode" != "alpine" ]; then
        while true; do
            read_input "Web 日志观察端口 (留空默认 80)" "$OPT_WEB_PORT" OPT_WEB_PORT
            if [ -z "$OPT_WEB_PORT" ] || is_valid_port "$OPT_WEB_PORT"; then
                break
            fi
            msg_warn "端口号无效，请输入 1-65535 之间的数字。"
            OPT_WEB_PORT=""
        done
    fi
}

append_common_args() {
    local -n arr_ref=$1
    [ -n "${OPT_USER:-}" ]        && arr_ref+=("--username" "$OPT_USER")
    [ -n "${OPT_PASS:-}" ]        && arr_ref+=("--password" "$OPT_PASS")
    [ -n "${OPT_SSH_KEY:-}" ]     && arr_ref+=("--ssh-key" "$OPT_SSH_KEY")
    [ -n "${OPT_SSH_PORT:-}" ]    && arr_ref+=("--ssh-port" "$OPT_SSH_PORT")
    [ -n "${OPT_WEB_PORT:-}" ]    && arr_ref+=("--web-port" "$OPT_WEB_PORT")
    [ -n "${OPT_RDP_PORT:-}" ]    && arr_ref+=("--rdp-port" "$OPT_RDP_PORT")
    [ -n "${OPT_FRPC:-}" ]        && arr_ref+=("--frpc-config" "$OPT_FRPC")
    [ -n "${OPT_HOLD:-}" ]        && arr_ref+=("--hold" "$OPT_HOLD")
    [ -n "${OPT_TARGET_DISK:-}" ] && arr_ref+=("--target-disk" "$OPT_TARGET_DISK")
    [ "${OPT_FORCE_CN:-0}" = "1" ] && arr_ref+=("--force-cn")
    [ "${OPT_DEBUG:-0}" = "1" ]    && arr_ref+=("--debug")
    if [ -n "${OPT_EXTRA:-}" ]; then
        local extra_parts=()
        read -r -a extra_parts <<< "$OPT_EXTRA"
        arr_ref+=("${extra_parts[@]}")
    fi
}

prompt_advanced_common() {
    local allow_hold="${1:-1}"
    if ! confirm_yn "是否配置高级选项 (--frpc-config / --hold / --target-disk / --force-cn / 附加参数)？" "N"; then
        return 0
    fi

    read_input "frpc 配置文件路径或 URL (--frpc-config，留空跳过)" "" OPT_FRPC
    if [ "$allow_hold" -eq 1 ]; then
        printf '  --hold 1: 仅重启进入安装环境不自动安装\n'
        printf '  --hold 2: 安装完成后不重启，停留在内存环境便于修改磁盘文件\n'
        read_input "hold 模式 (留空 / 1 / 2)" "" OPT_HOLD
        if [ -n "$OPT_HOLD" ] && [ "$OPT_HOLD" != "1" ] && [ "$OPT_HOLD" != "2" ]; then
            msg_warn "无效的 hold 值，已忽略。"
            OPT_HOLD=""
        fi
    fi
    read_input "指定目标硬盘 (--target-disk，如 /dev/sda，留空自动识别)" "" OPT_TARGET_DISK
    if confirm_yn "是否强制使用国内镜像 (--force-cn)？" "$( [ "$CFG_FORCE_CN" = "1" ] && echo Y || echo N )"; then
        OPT_FORCE_CN="1"
    else
        OPT_FORCE_CN="0"
    fi
    if confirm_yn "是否开启调试模式 (--debug)？" "N"; then
        OPT_DEBUG="1"
    fi
    read_input "其它自定义附加参数 (空格分隔，留空跳过)" "" OPT_EXTRA
}

# ---------------------------------------------------------------------------
# Feature 1: Install Linux
# ---------------------------------------------------------------------------

menu_linux() {
    clear_screen
    printf '%s================ 1. 重装 Linux 系统 ================%s\n' "$C_CYAN" "$C_RESET"
    printf '  1) Debian         (9 / 10 / 11 / 12 / 13)\n'
    printf '  2) Ubuntu         (18.04 / 20.04 / 22.04 / 24.04 / 26.04 / 26.10)\n'
    printf '  3) Alpine         (3.21 / 3.22 / 3.23 / 3.24)\n'
